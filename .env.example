# ─────────────────────────────────────────────────────────────────────────
# Nexus Investments — environment configuration template
# Copy to `.env` for local dev. NEVER commit a real `.env`.
# In staging/production, these are supplied by the secrets manager
# (05-security-architecture.md §3) — this file only documents the shape.
# ─────────────────────────────────────────────────────────────────────────

# ---- Platform mode --------------------------------------------------------
# sandbox = no real money movement possible, testnet chains only (default).
# live    = refuses to boot without a signed compliance attestation file.
PLATFORM_MODE=sandbox
NODE_ENV=development

# ---- API -------------------------------------------------------------------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ---------------------------------------------------------------
DATABASE_URL=postgresql://nexus:nexus_dev_password@localhost:5432/nexus_investments?schema=public

# ---- Redis (cache, sessions, rate limiting, BullMQ) -------------------------
REDIS_URL=redis://localhost:6379

# ---- Auth / sessions ----------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# TOTP issuer name shown in authenticator apps
TOTP_ISSUER="Nexus Investments"

# ---- Rate limiting ------------------------------------------------------------
# Applies to every route globally. A few sensitive auth endpoints (register/login/2FA verify)
# additionally carry a stricter, static rate limit set directly on the route in
# apps/api/src/auth/auth.controller.ts — intentionally not env-configurable, see the comment
# there.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT_DEFAULT=120

# ---- Observability --------------------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=info

# ---- MVP2 (blockchain / wallet / deposits) ----------------------------------
# See docs/06-blockchain-architecture.md §8 for provider recommendations.
EVM_RPC_URL_SEPOLIA=
SOLANA_RPC_URL_DEVNET=
TRON_RPC_URL_SHASTA=
BITCOIN_RPC_URL_TESTNET=
WALLET_SIGNING_PROVIDER=local-dev-keystore   # NEVER "local-dev-keystore" in production

# Account-level extended PUBLIC key (m/44'/60'/0') used to derive deposit addresses.
# An xpub is a public key: it derives addresses and can sign nothing. Private keys and seeds
# never appear in configuration at all — see docs/06-blockchain-architecture.md §4.
# A chain missing either its RPC URL or its xpub is skipped with a loud warning, never
# silently watched-but-not-watching.
EVM_ACCOUNT_XPUB_SEPOLIA=

# Deposit watcher. Correctness does not depend on these — deposits are idempotent on
# (chain, txHash, logIndex), so rescanning a range cannot double-credit — they are purely a
# cost/latency trade-off.
DEPOSIT_SCAN_BATCH_BLOCKS=50
DEPOSIT_SCAN_INTERVAL_MS=30000
DEPOSIT_WATCHER_DISABLED=            # "1" to disable (tests drive the watcher manually)

# Custody reconciliation: what the ledger says the platform owes vs. what the chains actually
# hold. A shortfall files a high-severity RECONCILIATION_MISMATCH risk event. See docs/06 §6.
RECONCILIATION_INTERVAL_MS=900000
RECONCILIATION_DISABLED=             # "1" to disable

# ---- NAV engine (MVP15) -----------------------------------------------------
# Prices are sourced, never supplied: there is no config here through which an operator could
# set a valuation. See docs/12 §5.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# How old a mark may be before valuation refuses it. A dead feed answers instantly with
# yesterday's price, so this is the only thing between a frozen oracle and a NAV that looks
# perfectly healthy.
MARK_MAX_AGE_SECONDS=900
MARK_CACHE_TTL_SECONDS=60
NAV_REVALUATION_INTERVAL_MS=300000
NAV_REVALUATION_DISABLED=            # "1" to disable (tests drive revaluation manually)

# ---- Fee engine (MVP16/17) --------------------------------------------------
# The interval deliberately does not appear in the fee arithmetic: each position stores the end
# of the period it was last charged for, so running more or less often than planned changes when
# a charge is computed, never how much it is. See docs/12 §6.
FEE_ACCRUAL_INTERVAL_MS=3600000
FEE_ACCRUAL_DISABLED=                # "1" to disable (tests drive accrual manually)

# ---- AI data platform (MVP32) — docs/17 -------------------------------------
# Pairs and timeframes the ingestion loop pulls. Config rather than a constant in code, so the
# scanned universe has one source of truth.
MARKET_DATA_SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT
MARKET_DATA_TIMEFRAMES=1m,5m,15m,1h,4h,1d
MARKET_DATA_INGESTION_INTERVAL_MS=60000
MARKET_DATA_INGESTION_DISABLED=      # "1" to disable (tests drive ingestion manually)

# OKX is the primary and Coinbase the cross-check. Not Binance: it geo-blocks this deployment,
# as does Bybit — a finding from calling the endpoints, not from the docs. Neither needs a key.
OKX_BASE_URL=https://www.okx.com
COINBASE_BASE_URL=https://api.exchange.coinbase.com

# ---- MVP3+ (KYC/AML) — not required for MVP1 --------------------------------
KYC_PROVIDER_API_KEY=
SANCTIONS_PROVIDER_API_KEY=

# ---- MVP7 (news / macro / on-chain) — not required for MVP1 -----------------
CRYPTOPANIC_API_KEY=
FINNHUB_API_KEY=
COINGECKO_API_KEY=

# ---- Notifications (email/telegram) — MVP1 uses a console-log adapter --------
NOTIFICATIONS_EMAIL_PROVIDER=console   # console | resend | ses
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
