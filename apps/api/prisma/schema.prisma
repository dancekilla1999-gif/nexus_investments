// Nexus Investments — Prisma schema
//
// This is the canonical, full data model referenced by docs/03-database-architecture.md.
// MVP1 tables (User, Profile, Device, RefreshSession, BackupCode, ApiKey, AuditLog,
// RiskEvent placeholder) are live and exercised by apps/api/src/{auth,users,audit}.
// MVP2+ tables are defined now so later milestones are additive migrations, not schema
// redesigns — see docs/09-roadmap.md.
//
// Conventions:
//  - Money/amount fields use Decimal(36, 18) — enough precision for the smallest-denomination
//    unit of any supported chain asset (e.g. wei), never a float.
//  - Every financial mutation table carries a unique idempotencyKey (docs/03 §3).
//  - Append-only tables (AuditLog, LedgerEntry, SignalResult) have no update/delete service
//    methods anywhere in the codebase by convention — enforced at the repository layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity & access (MVP1 — live)
// ─────────────────────────────────────────────────────────────────────────

/// Operator roles. The full matrix of what each may and may not do is docs/12 §8; two rules
/// govern the whole set:
///
///  - No role, SUPERADMIN included, has a path to user or pool funds. Being an administrator
///    confers configuration authority, never economic authority — enforced by the ledger's
///    ownership-boundary trigger, so it holds even against someone who can change application
///    code but cannot ship a migration unreviewed.
///  - Risk-limit and fee-schedule changes are dual-control: proposed by one role, approved by
///    another, both recorded.
enum UserRole {
  USER
  SUPPORT
  COMPLIANCE
  RISK_OPS
  /// Creates and configures investment products; cannot publish one without a passing backtest.
  INVESTMENT_MANAGER
  /// Places orders for explicitly assigned strategies only. Cannot change limits or move value.
  TRADER
  /// Views fee calculations and triggers crystallisation runs; cannot change rates.
  FINANCE
  /// Read-only analytics.
  ANALYST
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  CLOSED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  emailVerifiedAt   DateTime?
  phone             String?
  phoneVerifiedAt   DateTime?
  passwordHash      String
  role              UserRole   @default(USER)
  status            UserStatus @default(PENDING_VERIFICATION)

  // Security Center
  antiPhishingCode  String?
  totpSecretEnc     String?    // envelope-encrypted at the application layer, never plaintext
  totpEnabled       Boolean    @default(false)
  withdrawalWhitelistEnabled Boolean @default(false)

  referralCode      String     @unique @default(cuid())
  referredById      String?
  referredBy        User?      @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers     User[]     @relation("UserReferrals")

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastLoginAt       DateTime?

  profile           Profile?
  devices           Device[]
  sessions          RefreshSession[]
  backupCodes       BackupCode[]
  apiKeys           ApiKey[]
  notifications     Notification[]

  // MVP2+ relations (schema stable now, services land per milestone)
  kycCases          KycCase[]
  amlCases          AmlCase[]
  walletAddresses   WalletAddress[]
  ledgerAccounts    LedgerAccount[]
  balances          Balance[]
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  orders            Order[]
  p2pAds            P2PAd[]
  p2pOrdersAsBuyer  P2POrder[] @relation("P2POrderBuyer")
  p2pOrdersAsSeller P2POrder[] @relation("P2POrderSeller")
  subscriptions     Subscription[]
  riskEvents        RiskEvent[]

  // Managed Accounts / legal (docs/10-managed-accounts-architecture.md) — schema live now,
  // services land in MVP11; the risk-disclosure acceptance flow ships in MVP1 (see roadmap).
  riskDisclosureAcceptances RiskDisclosureAcceptance[]
  managedAccounts           ManagedAccount[]

  // Investment management (docs/12) — Mode B
  investmentPositions  InvestmentPosition[]
  subscriptionRequests SubscriptionRequest[]
  redemptionRequests   RedemptionRequest[]

  @@index([email])
  @@map("users")
}

model Profile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?
  country           String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?

  preferredCurrency String    @default("USD")
  timezone          String    @default("UTC")
  locale            String    @default("en")
  avatarUrl         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("profiles")
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  fingerprint String
  userAgent   String?
  ip          String?
  label       String?
  trusted     Boolean   @default(false)

  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?

  sessions    RefreshSession[]

  @@unique([userId, fingerprint])
  @@map("devices")
}

model RefreshSession {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId          String?
  device            Device?   @relation(fields: [deviceId], references: [id])

  tokenHash         String    @unique
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedBySessionId String?
  stepUpVerifiedAt  DateTime?

  ip                String?
  userAgent         String?

  @@index([userId])
  @@map("refresh_sessions")
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("backup_codes")
}

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  keyPrefix   String
  keyHash     String    @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

// ─────────────────────────────────────────────────────────────────────────
// Platform-wide: audit & risk (infra live in MVP1, fully exercised MVP3/9)
// ─────────────────────────────────────────────────────────────────────────

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

/// Append-only. No update/delete path exists anywhere in the service layer.
model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum RiskEventType {
  WITHDRAWAL_VELOCITY
  NEW_DEVICE
  NEW_ADDRESS
  RECONCILIATION_MISMATCH
  P2P_FRAUD_SIGNAL
  AML_FLAG
  LOGIN_ANOMALY
  /// docs/10-managed-accounts-architecture.md §4 — a Managed Account breached its
  /// maxDrawdownBps ceiling and was moved to CIRCUIT_BROKEN.
  MANAGED_ACCOUNT_CIRCUIT_BREAKER
  OTHER
}

enum RiskEventStatus {
  OPEN
  REVIEWING
  CLEARED
  ESCALATED
  ACTION_TAKEN
}

model RiskEvent {
  id           String          @id @default(cuid())
  userId       String?
  user         User?           @relation(fields: [userId], references: [id])
  type         RiskEventType
  status       RiskEventStatus @default(OPEN)
  severity     Int             @default(1)
  details      Json?
  createdAt    DateTime        @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([userId])
  @@index([status])
  @@map("risk_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Compliance (MVP3)
// ─────────────────────────────────────────────────────────────────────────

enum KycTier {
  NONE
  BASIC
  VERIFIED
  ENHANCED
}

enum KycCaseStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

model KycCase {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  tier             KycTier       @default(BASIC)
  status           KycCaseStatus @default(PENDING)
  provider         String?
  providerRef      String?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId])
  @@map("kyc_cases")
}

enum AmlCaseStatus {
  OPEN
  CLEARED
  ESCALATED
  CLOSED
}

model AmlCase {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  status                AmlCaseStatus @default(OPEN)
  reason                String?
  relatedTransactionId  String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  closedAt              DateTime?

  @@index([userId])
  @@map("aml_cases")
}

// ─────────────────────────────────────────────────────────────────────────
// Custody & chain (MVP2)
// ─────────────────────────────────────────────────────────────────────────

enum ChainType {
  EVM
  SOLANA
  TRON
  BITCOIN
}

model Chain {
  id                     String    @id @default(cuid())
  key                    String    @unique // "ethereum", "arbitrum", "base", "bnb", "polygon", "solana", "tron", "bitcoin"
  name                   String
  type                   ChainType
  isTestnet              Boolean   @default(true)
  nativeAssetSymbol      String
  explorerUrlTemplate    String?
  confirmationsRequired  Int       @default(12)
  isEnabled              Boolean   @default(true)

  /// Highest block the deposit watcher has fully processed. Null = not yet scanned; the
  /// watcher starts from the current head rather than replaying the chain's entire history.
  lastScannedBlock       BigInt?
  /// Monotonic BIP-44 address index allocator. Handed out under a row lock so two concurrent
  /// address requests can never receive the same index — which would give two users the same
  /// deposit address and make their funds indistinguishable.
  nextDerivationIndex    Int       @default(0)

  assets                 Asset[]
  wallets                Wallet[]
  walletAddresses        WalletAddress[]
  blockchainTransactions BlockchainTransaction[]
  deposits               Deposit[]
  withdrawals            Withdrawal[]

  @@map("chains")
}

enum AssetKind {
  NATIVE
  TOKEN
}

model Asset {
  id              String    @id @default(cuid())
  symbol          String
  name            String
  chainId         String
  chain           Chain     @relation(fields: [chainId], references: [id])
  contractAddress String?
  decimals        Int       @default(18)
  kind            AssetKind @default(TOKEN)
  isEnabled       Boolean   @default(true)
  coingeckoId     String?

  walletAddresses        WalletAddress[]
  blockchainTransactions BlockchainTransaction[]
  ledgerAccounts         LedgerAccount[]
  balances               Balance[]
  deposits               Deposit[]
  withdrawals            Withdrawal[]
  marketsAsBase           Market[] @relation("MarketBaseAsset")
  marketsAsQuote          Market[] @relation("MarketQuoteAsset")
  p2pAds                  P2PAd[]
  investmentStrategies    InvestmentStrategy[]

  @@unique([chainId, symbol])
  @@map("assets")
}

enum WalletCustodyType {
  HOT
  COLD
}

/// Platform custody wallets (not per-user) — see docs/06-blockchain-architecture.md §4.
model Wallet {
  id        String            @id @default(cuid())
  chainId   String
  chain     Chain             @relation(fields: [chainId], references: [id])
  type      WalletCustodyType
  label     String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())

  addresses WalletAddress[]

  @@map("wallets")
}

/// Per-user, per-chain deposit address, deterministically derived from a custody wallet.
model WalletAddress {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  chainId          String
  chain            Chain    @relation(fields: [chainId], references: [id])
  assetId          String?
  asset            Asset?   @relation(fields: [assetId], references: [id])
  walletId         String
  wallet           Wallet   @relation(fields: [walletId], references: [id])

  address          String
  derivationIndex  Int
  createdAt        DateTime @default(now())

  @@unique([chainId, address])
  @@unique([chainId, derivationIndex])
  @@unique([userId, chainId])
  @@index([userId, chainId])
  @@map("wallet_addresses")
}

enum ChainTxDirection {
  IN
  OUT
}

enum ChainTxStatus {
  PENDING
  CONFIRMED
  FAILED
}

/// Read-only mirror of what the chain adapters observed — NOT the source of truth for user
/// balances. See docs/03-database-architecture.md §1.
model BlockchainTransaction {
  id            String           @id @default(cuid())
  chainId       String
  chain         Chain            @relation(fields: [chainId], references: [id])
  txHash        String
  logIndex      Int              @default(0)
  fromAddress   String?
  toAddress     String?
  assetId       String?
  asset         Asset?           @relation(fields: [assetId], references: [id])
  amount        Decimal          @db.Decimal(36, 18)
  confirmations Int              @default(0)
  status        ChainTxStatus    @default(PENDING)
  direction     ChainTxDirection
  blockNumber   BigInt?
  observedAt    DateTime         @default(now())

  @@unique([chainId, txHash, logIndex])
  @@map("blockchain_transactions")
}

// ─────────────────────────────────────────────────────────────────────────
// Ledger — system of record for money (MVP2). See docs/03 §1-3.
// ─────────────────────────────────────────────────────────────────────────

enum LedgerAccountType {
  // ── User-facing balance buckets (docs/03-database-architecture.md §2). Never negative. ──
  AVAILABLE
  TRADING
  LOCKED
  FUNDING
  BONUS
  PENDING

  /// The platform boundary — a contra-account representing value that has crossed in or out of
  /// the system (an on-chain deposit arriving, a withdrawal leaving, a fee being earned).
  ///
  /// Double-entry has no concept of value appearing from nowhere: a deposit must debit
  /// *something* to credit the user. That something is this account, and its balance is
  /// legitimately negative — it measures the platform's cumulative obligation to its users,
  /// which is exactly the number custody reconciliation compares against on-chain holdings
  /// (docs/06-blockchain-architecture.md §5). It is therefore exempt from the non-negative
  /// constraint, and it is never owned by, or visible to, a user.
  EXTERNAL

  /// The sandbox faucet's contra-account — synthetic value that never crossed a chain.
  ///
  /// Kept structurally separate from EXTERNAL rather than sharing it, because the two make
  /// opposite promises. EXTERNAL asserts "this much really arrived and is really held
  /// somewhere"; faucet money asserts the opposite. Posting both to EXTERNAL made custody
  /// reconciliation weigh a sandbox's play balances against real on-chain holdings and report a
  /// permanent multi-thousand-ETH shortfall — and an alarm that always fires is an alarm nobody
  /// reads, which is worse than no alarm at all on the one check that would catch the platform
  /// being unable to pay its users. (Found by running reconciliation against a live node.)
  ///
  /// Also negative by nature, and likewise exempt from the non-negative constraint. A live
  /// deployment can never accumulate a balance here — the faucet refuses to run outside sandbox
  /// (WalletService.faucet) — so a non-zero SANDBOX_MINT balance in production is itself a
  /// finding.
  SANDBOX_MINT

  // ── Investment management ownership domains (docs/12 §1) ──────────────
  // Ownership is a property of the ACCOUNT, not of a comment on a transaction. That is what
  // lets the ledger answer "whose money is this?" at any instant.

  /// Investor capital committed to a strategy but not yet at a dealing point. Still the
  /// USER'S money: a subscription cancelled before the dealing point is returned in full
  /// (docs/12 §2.2). Held under the investor's own userId, like any other user bucket.
  PENDING_SUBSCRIPTION

  /// Assets of a strategy pool — cash and positions — owned by that strategy's investors
  /// collectively, pro rata by units. NOT platform money, and structurally unreachable by any
  /// operator: see the boundary trigger.
  STRATEGY_POOL

  /// The platform's own operating capital. The only balances the platform may actually spend,
  /// alongside PLATFORM_REVENUE.
  PLATFORM_TREASURY

  /// Fees the platform has earned and settled. Value arrives here only via
  /// FEE_CRYSTALLISATION or a TRADE's venue/execution fee leg.
  PLATFORM_REVENUE
}

model LedgerAccount {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  assetId   String
  asset     Asset             @relation(fields: [assetId], references: [id])
  type      LedgerAccountType

  /// Null = the user's own self-directed balance. Set = this ledger account belongs to one of
  /// the user's Managed Accounts (docs/10-managed-accounts-architecture.md §5) — structurally
  /// impossible to commingle with personal balances since it's a different ledger account
  /// entirely, moved between only via an explicit TRANSFER_INTERNAL ledger transaction.
  managedAccountId String?
  managedAccount   ManagedAccount? @relation(fields: [managedAccountId], references: [id])

  /// Set on STRATEGY_POOL accounts — the pool this asset balance belongs to. Pool accounts are
  /// owned by the strategy's investors collectively, so their `userId` is the platform system
  /// user purely to satisfy the relation; ownership is carried by `type` + `strategyId`, and
  /// the boundary trigger keys off `type`, never off `userId`.
  strategyId String?
  strategy   InvestmentStrategy? @relation(fields: [strategyId], references: [id])

  createdAt DateTime          @default(now())

  entries   LedgerEntry[]
  balance   Balance?

  // Postgres treats NULLs as distinct in a unique index, so this constraint alone does NOT
  // stop two personal (managedAccountId = null) ledger accounts of the same
  // (userId, assetId, type) from existing. The gap is closed by a partial unique index
  // (`ledger_accounts_personal_unique`) in migration 20260814091830_ledger_integrity_constraints
  // — partial indexes are not expressible in Prisma's schema DSL, so it lives in raw SQL.
  @@unique([userId, managedAccountId, assetId, type])
  @@map("ledger_accounts")
}

enum LedgerTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  TRANSFER_INTERNAL
  P2P_ESCROW
  P2P_RELEASE
  FEE
  REFERRAL_COMMISSION
  ADJUSTMENT

  // ── Investment management (docs/12, docs/14) ──
  /// Investor's committed capital leaving PENDING_SUBSCRIPTION and entering the pool, against
  /// units issued at the dealing-point NAV.
  SUBSCRIPTION_SETTLEMENT
  /// Units cancelled at the dealing-point NAV; proceeds returned to the investor's own wallet.
  REDEMPTION_SETTLEMENT
  /// Accrued management/performance fee actually paid: pool → platform revenue.
  FEE_CRYSTALLISATION
  /// A venue/execution fee on a fill. Deliberately a separate type from TRADE: if TRADE itself
  /// were allowed to touch a platform account, "a trade" would be a general-purpose way to move
  /// investor money to the platform for any amount. TRADE stays pool-internal (cash ↔ asset);
  /// the fee is its own typed, boundary-crossing posting, atomic with the fill because both are
  /// written in one database transaction.
  TRADING_FEE
}

model LedgerTransaction {
  id             String                @id @default(cuid())
  type           LedgerTransactionType
  idempotencyKey String                @unique
  referenceType  String?
  referenceId    String?
  metadata       Json?
  createdAt      DateTime              @default(now())

  entries        LedgerEntry[]

  @@index([referenceType, referenceId])
  @@map("ledger_transactions")
}

/// Append-only. Sum of entries for a given ledgerTransactionId MUST equal zero — enforced by
/// the LedgerService (application layer) and verified by a reconciliation test
/// (docs/09-roadmap.md MVP2 acceptance criteria). No update/delete service method exists.
model LedgerEntry {
  id                  String            @id @default(cuid())
  ledgerTransactionId String
  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id])
  ledgerAccountId     String
  ledgerAccount       LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])
  amount              Decimal           @db.Decimal(36, 18) // signed: credit > 0, debit < 0
  createdAt           DateTime          @default(now())

  @@index([ledgerAccountId])
  @@index([ledgerTransactionId])
  @@map("ledger_entries")
}

/// Materialized projection of LedgerEntry sums, rebuildable from scratch at any time
/// (LedgerService.recomputeBalance / verifyReconciliation).
///
/// Keyed 1:1 to a LedgerAccount rather than to (userId, assetId, type): a balance is by
/// definition "the sum of one ledger account's entries", so tying it to anything else invites
/// the projection and the account it describes drifting apart — and would need its own
/// managedAccountId column kept manually in sync with the account's
/// (docs/10-managed-accounts-architecture.md §5). userId/assetId/type are denormalized copies
/// purely so "all balances for this user" is one indexed read with no join.
model Balance {
  id              String            @id @default(cuid())
  ledgerAccountId String            @unique
  ledgerAccount   LedgerAccount     @relation(fields: [ledgerAccountId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  assetId         String
  asset           Asset             @relation(fields: [assetId], references: [id])
  type            LedgerAccountType
  amount          Decimal           @db.Decimal(36, 18) @default(0)
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@map("balances")
}

enum DepositStatus {
  DETECTED
  PENDING_CONFIRMATION
  CONFIRMED
  CREDITED
  FAILED
}

model Deposit {
  id                  String        @id @default(cuid())
  userId              String
  user                User          @relation(fields: [userId], references: [id])
  chainId             String
  chain               Chain         @relation(fields: [chainId], references: [id])
  assetId             String
  asset               Asset         @relation(fields: [assetId], references: [id])
  txHash              String
  /// Zero for native-asset transfers, which emit no log. Together with (chainId, txHash) this
  /// is the natural key of an on-chain transfer and the basis of deposit idempotency.
  logIndex            Int           @default(0)
  blockNumber         BigInt
  fromAddress         String?
  toAddress           String
  amount              Decimal       @db.Decimal(36, 18)
  confirmations       Int           @default(0)
  status              DepositStatus @default(DETECTED)
  /// Set when the pending credit is posted; a second ledger transaction moves PENDING to
  /// AVAILABLE once the chain's confirmation threshold is met.
  ledgerTransactionId String?
  idempotencyKey      String        @unique
  detectedAt          DateTime      @default(now())
  creditedAt          DateTime?

  @@unique([chainId, txHash, logIndex])
  @@index([userId])
  @@index([status])
  @@map("deposits")
}

enum WithdrawalStatus {
  REQUESTED
  RISK_REVIEW
  APPROVED
  REJECTED
  BROADCASTING
  BROADCAST
  CONFIRMED
  FAILED
}

model Withdrawal {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  chainId        String
  chain          Chain            @relation(fields: [chainId], references: [id])
  assetId        String
  asset          Asset            @relation(fields: [assetId], references: [id])
  toAddress      String
  amount         Decimal          @db.Decimal(36, 18)
  feeAmount      Decimal          @db.Decimal(36, 18) @default(0)
  status         WithdrawalStatus @default(REQUESTED)
  riskScore      Int?
  approvedById   String?
  txHash         String?
  idempotencyKey String           @unique
  requestedAt    DateTime         @default(now())
  completedAt    DateTime?

  @@index([userId])
  @@map("withdrawals")
}

// ─────────────────────────────────────────────────────────────────────────
// Trading (MVP4)
// ─────────────────────────────────────────────────────────────────────────

model Market {
  id           String   @id @default(cuid())
  symbol       String   @unique // "BTC/USDT"
  baseAssetId  String
  baseAsset    Asset    @relation("MarketBaseAsset", fields: [baseAssetId], references: [id])
  quoteAssetId String
  quoteAsset   Asset    @relation("MarketQuoteAsset", fields: [quoteAssetId], references: [id])
  isEnabled    Boolean  @default(true)
  isScanned    Boolean  @default(false) // written by the Top Markets Engine job, not manual
  rank         Int?
  volume24h    Decimal? @db.Decimal(36, 18)

  orders       Order[]
  trades       Trade[]
  marketData   MarketCandle[]
  signals      Signal[]

  @@map("markets")
}

model MarketCandle {
  id        String   @id @default(cuid())
  marketId  String
  market    Market   @relation(fields: [marketId], references: [id])
  timeframe String   // "1m","5m","15m","1h","4h","1d"
  openTime  DateTime
  open      Decimal  @db.Decimal(36, 18)
  high      Decimal  @db.Decimal(36, 18)
  low       Decimal  @db.Decimal(36, 18)
  close     Decimal  @db.Decimal(36, 18)
  volume    Decimal  @db.Decimal(36, 18)

  @@unique([marketId, timeframe, openTime])
  @@map("market_data")
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_LIMIT
  TAKE_PROFIT
  OCO
}

enum OrderStatus {
