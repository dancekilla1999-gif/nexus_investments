// ─────────────────────────────────────────────────────────────────────────
// Legal / Managed Accounts / Strategy Validation
// (docs/10-managed-accounts-architecture.md, docs/11-backtesting-architecture.md)
//
// RiskDisclosureAgreement + RiskDisclosureAcceptance ship as real, working code in MVP1 (see
// docs/09-roadmap.md) — this is the compliance precondition every Managed Account requires,
// and it doesn't depend on the trading machinery the rest of this section does.
//
// ManagedAccount / TradingStrategy / BacktestRun / BacktestResult are schema-only until
// MVP11 — no service creates or mutates them yet. Additive migrations only from here, matching
// this project's "schema stable early, services land per milestone" convention.
// ─────────────────────────────────────────────────────────────────────────

model RiskDisclosureAgreement {
  id           String   @id @default(cuid())
  version      Int      @unique
  title        String
  bodyMarkdown String
  isCurrent    Boolean  @default(false)
  effectiveAt  DateTime
  createdAt    DateTime @default(now())

  acceptances  RiskDisclosureAcceptance[]

  @@map("risk_disclosure_agreements")
}

/// Insert-only — docs/10-managed-accounts-architecture.md §3. No update/delete service method
/// exists for this model, same convention as AuditLog/LedgerEntry/SignalResult
/// (docs/03-database-architecture.md §5). This is the legal record that the investor was told
/// the risks before any capital was ever allocated — it does not get edited after the fact.
model RiskDisclosureAcceptance {
  id          String                  @id @default(cuid())
  userId      String
  user        User                    @relation(fields: [userId], references: [id])
  agreementId String
  agreement   RiskDisclosureAgreement @relation(fields: [agreementId], references: [id])
  acceptedAt  DateTime                @default(now())
  ip          String?
  userAgent   String?

  @@unique([userId, agreementId])
  @@index([userId])
  @@map("risk_disclosure_acceptances")
}

enum ManagedAccountStatus {
  PENDING_AGREEMENT
  ACTIVE
  CIRCUIT_BROKEN
  CLOSED
}

/// Segregated per-investor sub-account, never a pooled fund — docs/10 §2. Schema-only until
/// MVP11; no service creates one of these yet.
model ManagedAccount {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation(fields: [userId], references: [id])
  strategyId          String?
  strategy            TradingStrategy?     @relation(fields: [strategyId], references: [id])
  status              ManagedAccountStatus @default(PENDING_AGREEMENT)
  initialCapital      Decimal              @db.Decimal(36, 18)
  highWaterMark       Decimal              @db.Decimal(36, 18)
  /// Hard platform ceiling is 1000 (10%) — docs/10 §4. An investor/manager may set a stricter
  /// (lower) value; the service layer must reject anything higher, not just the UI.
  maxDrawdownBps      Int                  @default(1000)
  autoFlattenOnBreach Boolean              @default(false)
  createdAt           DateTime             @default(now())
  closedAt            DateTime?

  ledgerAccounts      LedgerAccount[]
  orders              Order[]

  @@index([userId])
  @@map("managed_accounts")
}

enum StrategyKind {
  RULE_BASED
  ML
}

enum StrategyPromotionStatus {
  BACKTESTING
  PAPER_TRADING
  LIVE_ELIGIBLE
}

/// docs/11-backtesting-architecture.md. Schema-only until MVP11.
model TradingStrategy {
  id              String                   @id @default(cuid())
  name            String
  version         Int
  kind            StrategyKind
  configJson      Json
  /// BACKTESTING → PAPER_TRADING → LIVE_ELIGIBLE — docs/11 §4. Three independent gates (this,
  /// PLATFORM_MODE=live, and a discretionary-trading legal review) all have to clear before
  /// real capital ever trades on this strategy.
  promotionStatus StrategyPromotionStatus @default(BACKTESTING)
  createdAt       DateTime                @default(now())

  managedAccounts ManagedAccount[]
  backtestRuns    BacktestRun[]
  investmentStrategies InvestmentStrategy[]

  @@unique([name, version])
  @@map("trading_strategies")
}

enum BacktestRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model BacktestRun {
  id                       String            @id @default(cuid())
  strategyId               String
  strategy                 TradingStrategy   @relation(fields: [strategyId], references: [id])
  dateRangeStart           DateTime
  dateRangeEnd             DateTime
  /// The exact, dated top-25 pair list this run actually used — never today's list applied
  /// retroactively (survivorship bias). docs/11 §2.
  pairUniverseSnapshotJson Json
  status                   BacktestRunStatus @default(PENDING)
  createdAt                DateTime          @default(now())

  result                   BacktestResult?

  @@index([strategyId])
  @@map("backtest_runs")
}

/// Insert-only — docs/11-backtesting-architecture.md §3. A bad result gets a new run with a
/// fixed strategy, never a hand-edited number.
model BacktestResult {
  id             String      @id @default(cuid())
  backtestRunId  String      @unique
  backtestRun    BacktestRun @relation(fields: [backtestRunId], references: [id])
  totalTrades    Int
  winRate        Float
  avgR           Float
  maxDrawdownBps Int
  sharpe         Float?
  sortino        Float?
  createdAt      DateTime    @default(now())

  @@map("backtest_results")
}

// ─────────────────────────────────────────────────────────────────────────
// Investment Management (MVP11+) — docs/12-investment-management-architecture.md
//
// Mode B of the platform: an investor contributes capital to a strategy pool and receives
// UNITS. The pool's assets are owned by its investors collectively, pro rata by units; the
// platform owns none of it and — enforced by a database trigger, not only by service code —
// has no path to it outside the named fee/settlement transaction types.
// ─────────────────────────────────────────────────────────────────────────

enum StrategyCustodyModel {
  /// Pooled fund with NAV-per-unit accounting. The only implemented model (docs/12 §0.2).
  POOLED_NAV
  /// Segregated per-investor sub-accounts mirroring the manager's trades — the model docs/10
  /// originally chose, kept as a declared variant for jurisdictions that forbid pooling.
  /// NOT IMPLEMENTED: the service layer refuses to create one rather than pretending it works.
  SEGREGATED_COPY
}

enum StrategyStatus {
  DRAFT
  /// A passing BacktestResult exists. Still cannot take capital.
  BACKTESTED
  /// Open for subscription.
  OPEN
  /// Existing investors kept, no new subscriptions.
  SOFT_CLOSED
  PAUSED
  WINDING_DOWN
  CLOSED
}

enum DealingFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

/// An investment product. Every economic term is configuration — nothing about fees, limits or
/// lock-ups is hardcoded anywhere in the application or the frontend.
model InvestmentStrategy {
  id          String               @id @default(cuid())
  slug        String               @unique
  name        String
  description String
  thesis      String?
  custodyModel StrategyCustodyModel @default(POOLED_NAV)
  status      StrategyStatus       @default(DRAFT)

  /// The asset NAV is denominated in.
  baseAssetId String
  baseAsset   Asset                @relation(fields: [baseAssetId], references: [id])

  /// Set once the strategy is validated; a strategy cannot reach OPEN without one (docs/11).
  tradingStrategyId String?
  tradingStrategy   TradingStrategy? @relation(fields: [tradingStrategyId], references: [id])

  minimumInvestment  Decimal   @db.Decimal(36, 18)
  maximumInvestment  Decimal?  @db.Decimal(36, 18)
  lockupDays         Int       @default(0)
  redemptionNoticeDays Int     @default(0)
  dealingFrequency   DealingFrequency @default(DAILY)

  /// Pure profit share by default — 50% of gain above the investor's high water mark, and
  /// nothing at all when there is no profit (docs/12 §6.0). Both are per-strategy config;
  /// perfFeeBps carries a platform ceiling of 5000 enforced by a CHECK constraint, so a typo
  /// cannot turn a 50% share into a 500% one.
  mgmtFeeBps Int @default(0)
  perfFeeBps Int @default(5000)

  /// Hard platform ceiling of 1000 (10%) — docs/10 §4, and load-bearing under a 50% profit
  /// share because the manager takes half the upside and none of the downside (docs/12 §6.0).
  maxDrawdownBps      Int @default(1000)
  maxAssetExposureBps Int @default(10000)
  maxLeverageBps      Int @default(10000)
  dailyLossLimitBps   Int?

  benchmarkSymbol String?

  /// Unit register. navPerUnit is derived (poolNAV / totalUnits) and lives on NavSnapshot —
  /// it is deliberately NOT a column here, so there is no field for anyone to hand-edit.
  totalUnits Decimal @db.Decimal(36, 18) @default(0)

  createdAt DateTime @default(now())
  openedAt  DateTime?
  closedAt  DateTime?

  positions InvestmentPosition[]
  navSnapshots NavSnapshot[]
  subscriptions SubscriptionRequest[]
  redemptions   RedemptionRequest[]
  ledgerAccounts LedgerAccount[]

  @@index([status])
  @@map("investment_strategies")
}

/// One per (investor, strategy). The investor's claim on the pool.
model InvestmentPosition {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  strategyId String
  strategy   InvestmentStrategy @relation(fields: [strategyId], references: [id])

  /// The claim itself. Value = units × navPerUnit.
  units      Decimal @db.Decimal(36, 18) @default(0)
  /// Total contributed less capital returned — the denominator for return %.
  costBasis  Decimal @db.Decimal(36, 18) @default(0)

  /// High water mark as a UNIT PRICE, not a dollar amount — the only form that is correct when
  /// investors enter at different times (docs/12 §6.1). Ratchets up on crystallisation and
  /// never decreases; written by the fee engine alone. Lowering it is indistinguishable from
  /// charging twice for the same performance, so no administrative path to do so exists.
  hwmUnitPrice Decimal @db.Decimal(36, 18) @default(0)

  /// Accrued but not yet crystallised. Deliberately NOT ledger postings: an accrual moves no
  /// assets, and posting it would drag every other investor's navPerUnit down for a fee they
  /// do not owe (docs/12 §1.1).
  accruedMgmtFee Decimal @db.Decimal(36, 18) @default(0)
  accruedPerfFee Decimal @db.Decimal(36, 18) @default(0)

  lockedUntil DateTime?
  createdAt   DateTime  @default(now())

  feeAccruals FeeAccrual[]

  @@unique([userId, strategyId])
  @@index([strategyId])
  @@map("investment_positions")
}

/// Immutable valuation record. `navPerUnit` is written here by the NAV engine and by nothing
/// else; there is no endpoint that sets NAV (docs/12 §5).
model NavSnapshot {
  id         String             @id @default(cuid())
  strategyId String
  strategy   InvestmentStrategy @relation(fields: [strategyId], references: [id])

  struckAt   DateTime @default(now())
  poolNav    Decimal  @db.Decimal(36, 18)
  totalUnits Decimal  @db.Decimal(36, 18)
  navPerUnit Decimal  @db.Decimal(36, 18)

  cashComponent     Decimal @db.Decimal(36, 18) @default(0)
  positionComponent Decimal @db.Decimal(36, 18) @default(0)

  /// Where the marks came from. A manager cannot supply a price — whoever sets prices authors
  /// their own performance fee.
  markSource String
  /// True when this snapshot is a dealing point: subscriptions and redemptions settle at it.
  isDealingPoint Boolean @default(false)

  @@unique([strategyId, struckAt])
  @@index([strategyId, isDealingPoint])
  @@map("nav_snapshots")
}

enum SubscriptionRequestStatus {
  /// Capital committed and held in the investor's PENDING_SUBSCRIPTION bucket.
  PENDING
  /// Units issued at a dealing point.
  SETTLED
  /// Returned in full to the investor, no fee — the money never left them.
  CANCELLED
}

model SubscriptionRequest {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  strategyId String
  strategy   InvestmentStrategy @relation(fields: [strategyId], references: [id])

  amount Decimal @db.Decimal(36, 18)
  status SubscriptionRequestStatus @default(PENDING)

  /// Set at settlement — the dealing point this subscribed at, and what it bought.
  settledSnapshotId String?
  unitsIssued       Decimal? @db.Decimal(36, 18)

  /// The disclosure the investor accepted before committing. Required — a subscription without
  /// a recorded acceptance of the current risk disclosure cannot be created.
  acceptanceId String

  idempotencyKey String @unique
  createdAt   DateTime  @default(now())
  settledAt   DateTime?
  cancelledAt DateTime?

  @@index([strategyId, status])
  @@index([userId])
  @@map("subscription_requests")
}

enum FeeAccrualKind {
  MANAGEMENT
  PERFORMANCE
}

/// Append-only record of every fee accrual, so an investor can reconstruct the arithmetic
/// behind any charge: period, rate, base, high water mark, result. A fee the investor cannot
/// recompute themselves is a fee they have to take on trust.
model FeeAccrual {
  id         String             @id @default(cuid())
  positionId String
  position   InvestmentPosition @relation(fields: [positionId], references: [id])

  kind       FeeAccrualKind
  periodStart DateTime
  periodEnd   DateTime
  /// The rate actually applied, copied at accrual time — a later config change must not
  /// retroactively alter what was charged.
  rateBps    Int
  /// What the rate was applied to.
  baseAmount Decimal @db.Decimal(36, 18)
  /// For PERFORMANCE: the HWM unit price the gain was measured above.
  hwmUnitPrice Decimal? @db.Decimal(36, 18)
  navPerUnit   Decimal? @db.Decimal(36, 18)
  amount     Decimal @db.Decimal(36, 18)

  /// Set when this accrual is settled by FEE_CRYSTALLISATION.
  crystallisedAt          DateTime?
  crystallisedTransactionId String?

  createdAt DateTime @default(now())

  @@index([positionId, kind])
  @@map("fee_accruals")
}

enum RedemptionRequestStatus {
  /// Requested; waiting for lock-up/notice to elapse and the next dealing point.
  PENDING
  /// Units cancelled and proceeds returned to the investor's wallet.
  SETTLED
  /// The pool lacked free cash; waiting for the manager to raise it. Still the investor's claim.
  QUEUED
  CANCELLED
}

model RedemptionRequest {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  strategyId String
  strategy   InvestmentStrategy @relation(fields: [strategyId], references: [id])

  /// Units the investor asked to redeem. Denominated in units, not currency, because the
  /// currency value is not known until the dealing-point NAV is struck — quoting an amount up
  /// front would be quoting a price the platform cannot honour.
  units  Decimal @db.Decimal(36, 18)
  status RedemptionRequestStatus @default(PENDING)

  /// The earliest dealing point this may settle at, stamped from lock-up and notice period at
  /// request time so a later config change cannot move an investor's date.
  eligibleFrom DateTime

  settledSnapshotId String?
  /// Set at settlement: gross proceeds, fees crystallised, and what actually reached the wallet.
  grossAmount Decimal? @db.Decimal(36, 18)
  feesCharged Decimal? @db.Decimal(36, 18)
  netAmount   Decimal? @db.Decimal(36, 18)

  idempotencyKey String @unique
  createdAt   DateTime  @default(now())
  settledAt   DateTime?
  cancelledAt DateTime?

  @@index([strategyId, status])
  @@index([userId])
  @@map("redemption_requests")
}
